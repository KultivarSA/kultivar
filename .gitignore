# Build-time secrets — passed via --dart-define-from-file.
# Copy env.example.json → env.json and fill in real values for local dev.
# CI/CD should inject these as GitHub Actions secrets or similar, never
# commit env.json to git.
env.json
env.local.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# F11 — gen-l10n outputs are derived from lib/l10n/*.arb at build time.
# Ignored to keep the diff focused on the ARB sources of truth (the
# generated files are regenerated by `flutter pub get` / `flutter gen-l10n`).
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# SR9 — Fastlane snapshot output.  Screenshots are regenerated from
# the running app every release, so we never commit the PNGs; they
# only live in App Store Connect once `fastlane screenshots_and_upload`
# has run.  The Snapfile / Fastfile / RunnerUITests source IS tracked.
ios/fastlane/screenshots/**/*.png
ios/fastlane/screenshots/**/screenshots.html
ios/fastlane/test_output/
ios/fastlane/README.md
ios/fastlane/report.xml
ios/fastlane/Preview.html

# ── Secrets / signing — NEVER commit ───────────────────────────────
#
# Public-repo hygiene.  Most of these don't exist YET, but defensive
# entries catch them the moment a future tutorial says "drop this
# file in the project root" -- before that file shows up in
# `git status` and gets accidentally staged.
#
# Android signing
android/key.properties
android/upload-keystore.jks
android/*.jks
android/*.keystore
*.jks
*.keystore

# Firebase / Google services (if ever added)
**/google-services.json
**/GoogleService-Info.plist
firebase_app_id_file.json

# iOS export / signing
ios/ExportOptions.plist
ios/Flutter/flutter_export_environment.sh
ios/.symlinks/
ios/Pods/

# macOS Pods
macos/Pods/
macos/Flutter/ephemeral/

# Android local
android/local.properties
android/.gradle/
android/.idea/
android/captures/
android/gradle-wrapper.jar

# Flutter Version Manager
.fvm/

# Generic secret-shaped files (defensive)
secrets.json
secrets.yaml
*.secret
service-account.json

# Editor noise
.vscode/
*.swp
*.swo
*~

# Claude Code per-machine config -- contains absolute paths and
# personal command-approval history.  The shared `.claude/settings.json`
# (if ever added) IS commit-worthy; everything else under .claude/ is
# per-user state.  Whole folder ignored for now -- carve out specific
# files later if a team config emerges.
.claude/

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini

# Patch / merge backup files
*.orig
*.rej
