<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon for the round-icon slot.

    Some launchers (Samsung One UI, certain Pixel configurations,
    Sony, some MIUI builds) request `android:roundIcon` separately
    from `android:icon`.  Without this file, those launchers fall
    back to the legacy raster PNGs in mipmap-{m,h,xh,xxh,xxxh}dpi
    -- which works, but the adaptive cropping is then bypassed and
    the result looks visibly less polished against neighbouring
    adaptive icons.

    Contents intentionally mirror `ic_launcher.xml` -- the launcher
    decides shape; we just provide the same three layers so both
    slots stay visually identical.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
