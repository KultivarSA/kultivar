<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device transfer rules.
  Referenced by android:dataExtractionRules in AndroidManifest.xml.

  We include SharedPreferences (all app data) and internal files
  (Hive databases plus grow photos stored in the app documents
  directory).  Cache and external storage are NOT included; they
  are either reconstructible or managed by the user directly.

  Bug fix (release lintVital): see backup_descriptor.xml for the
  rationale on why the cache and external exclude stanzas were
  dropped.  Short version: cache is not a valid backup domain and
  external was never included, so excluding it is a no op that
  release-mode lint flags as an error.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
